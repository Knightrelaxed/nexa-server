# AI Models - Core Backbone (Google Accounts 1 to 4)
GEMINI_API_KEY_1= # Akun Google Utama (Vision Tier 1, Text Tier 3, Voice Tier 5)
GEMINI_API_KEY_2= # Akun Google Ke-2
GEMINI_API_KEY_3= # Akun Google Ke-3
GEMINI_API_KEY_4= # Akun Google Ke-4

# AI Models - Free Tier / Fallback Providers
GROQ_API_KEY_1= # Akun Groq 1 (Llama 3.3 70B, Whisper, Llama 4 Scout)
GROQ_API_KEY_2= # Akun Groq 2
GROQ_API_KEY_3= # Akun Groq 3
GROQ_API_KEY_4= # Akun Groq 4
OPENROUTER_API_KEY= # Gemma 4, Nemotron (Text Safety Net)
CEREBRAS_API_KEY= # Llama 3.1 70B (Text Backup Sprinter)
MISTRAL_API_KEY= # Mixtral 8x22B (Text Fallback)
HF_TOKEN= # Qwen2-VL (Vision Safety Net)

# 3rd Party APIs
