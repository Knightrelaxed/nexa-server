# /etc/systemd/system/nexa-term.service
# PRD Lampiran A / FR-SRV-02..04, FR-TERM-01, FR-TERM-18:
# Sandboxed unprivileged inspection terminal (no sudo, no journal group, kill switch default OFF)
[Unit]
Description=N.E.X.A Terminal Shell Worker
Requires=nexa-term.socket

[Service]
User=nexa-term
Group=nexa-term
StateDirectory=nexa-term
StateDirectoryMode=0700
Environment=HOME=/var/lib/nexa-term
ExecStart=/opt/nexa/bin/nexa-io --mode=terminal
LoadCredential=ticket-pub.pem:/etc/nexa/ticket-pub.pem
Restart=no
KillMode=control-group
TimeoutStopSec=10s

# Network & privilege hardening: block all local loopback services (Caddy admin, Node WS, PM2)
IPAddressDeny=127.0.0.0/8 ::1/128
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
InaccessiblePaths=-/opt/nexa/server /etc/nexa -/home/nexa/nexa-server -/var/log/nexa

# Resource budgets
MemoryHigh=128M
MemoryMax=160M
TasksMax=128
CPUQuota=40%
