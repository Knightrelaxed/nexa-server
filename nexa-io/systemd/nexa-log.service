# /etc/systemd/system/nexa-log.service
# PRD Lampiran A / FR-SRV-02..04: Sandboxed on-demand log streamer worker (exits after 90s idle)
[Unit]
Description=N.E.X.A Log Streamer Worker
Requires=nexa-log.socket

[Service]
User=nexa-log
Group=nexa-log
SupplementaryGroups=systemd-journal
ExecStart=/opt/nexa/bin/nexa-io --mode=logs
LoadCredential=ticket-pub.pem:/etc/nexa/ticket-pub.pem
Restart=no
KillMode=control-group
TimeoutStopSec=10s

# Filesystem & privilege hardening
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# journalctl -f reads /proc/sys/kernel/random/boot_id (hidden by ProcSubset=pid)
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=-/var/log/nexa
InaccessiblePaths=-/opt/nexa/server /etc/nexa -/home/nexa/nexa-server

# Resource budgets
MemoryHigh=36M
MemoryMax=48M
TasksMax=32
CPUQuota=20%
